{
  "name": "cc-board",
  "version": "0.3.0",
  "description": "A local desktop bridge for native Claude Code",
  "author": "cc-board contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "npm run build && node tests/desktop-smoke.cjs",
    "test:desktop-native": "npm run build && node tests/desktop-native.cjs",
    "test:native": "node tests/native-bridge.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "pack": "npm run build && electron-builder --dir --win --x64"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "io.ccboard.desktop",
    "productName": "cc-board",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "electron/permission-server.cjs"
    ],
    "win": {
      "target": "nsis",
      "executableName": "cc-board",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "cc-board-Setup-${version}.${ext}"
    }
  }
}
